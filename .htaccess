RewriteEngine On
Options -MultiViews

# Keep Yukon's own folders private. These rules must come before the
# "existing file" pass-through below, otherwise real files are served anyway.
# Block /yukon-server entirely (better still: keep it outside the web root)
RewriteRule ^yukon-server(/.*)?$ - [F,L]

# Block /yukon except the media the site renders (/yukon/assets/media/*)
RewriteCond %{REQUEST_URI} ^/yukon [NC]
RewriteCond %{REQUEST_URI} !^/yukon/assets/media/ [NC]
RewriteCond %{REQUEST_URI} !^/yukon/media/ [NC]
RewriteRule ^yukon(/.*)?$ - [F,L]

# Repository-only files and folders are not part of the site
RewriteRule ^(sql|scripts|docs)(/.*)?$ - [F,L]
RewriteRule (^|/)\.git - [F,L]

# /manage_penguin/studio -> /manage_penguin/studio.php
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# Disable directory browsing
Options -Indexes
Options -MultiViews

# Custom error pages in /error-pages
ErrorDocument 400 /error-pages/400.php
ErrorDocument 401 /error-pages/401.php
ErrorDocument 403 /error-pages/403.php
ErrorDocument 404 /error-pages/404.php
ErrorDocument 408 /error-pages/408.php
ErrorDocument 410 /error-pages/410.php
ErrorDocument 429 /error-pages/429.php
ErrorDocument 500 /error-pages/500.php
ErrorDocument 502 /error-pages/502.php
ErrorDocument 504 /error-pages/504.php
ErrorDocument 503 /error-pages/maintenance.php
ErrorDocument 501 /error-pages/not_ready.php
